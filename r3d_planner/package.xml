<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r3d_planner</name>
  <version>0.0.1</version>
  <description>Graph-based A* path planning on classified PCD traversability data with a ComputePathToPose action, RViz integration, local obstacle filtering and path following.</description>
  <maintainer email="baau1001@stud.hs-kl.de">bauya</maintainer>
  <license>Apache-2.0</license>
  <author>Bastian Aumer</author>
  <url type="repository">https://github.com/RoboProjekt/R3D-Planner</url>
  <url type="bugtracker">https://github.com/RoboProjekt/R3D-Planner/issues</url>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <exec_depend>python3-open3d</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>
  <exec_depend>r3d_preprocessor</exec_depend>
  <exec_depend>r3d_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>action_msgs</test_depend>
  <test_depend>rosgraph_msgs</test_depend>
  <test_depend>ros2cli</test_depend>
  <test_depend>ros2launch</test_depend>
  <test_depend>ros2param</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
